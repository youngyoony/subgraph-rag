      "operations": [
        {
          "op": "join",
          "on": "provider_id"
        },
        {
          "op": "withColumn",
          "column": "outcome_attribution_score",
          "expression": "((1 - F.col('mortality_rate')) * 100 * 0.4 + F.col('loyalty_score') * 0.3 + (100 - F.col('clinical_complexity') * 5) * 0.3)"
        },
        {
          "op": "withColumn",
          "column": "attribution_tier",
          "expression": "F.when(F.col('outcome_attribution_score') >= 80, 'High Impact').when(F.col('outcome_attribution_score') >= 60, 'Moderate Impact').when(F.col('outcome_attribution_score') >= 40, 'Low Impact').otherwise('Minimal Impact')"
        }
      ],
